default_platform(:ios)

platform :ios do
  desc "Fetch certificates and provisioning profiles via Match"
  lane :fetch_certificates do |options|
    match_type = ENV['MATCH_TYPE'] || options[:type] || 'adhoc'
    
    match(
      type: match_type,
      readonly: true,
      git_url: ENV['MATCH_GIT_URL'],
      git_branch: ENV['MATCH_GIT_BRANCH'],
      keychain_name: "build.keychain",
      keychain_password: ENV['MATCH_PASSWORD']
    )
  end

  desc "Build the iOS app for a specific flavor (with signing)"
  lane :build do |options|
    flavor = options[:flavor]
    
    # Fetch certificates first
    fetch_certificates
    
    # Determine scheme name from flavor
    scheme_name = case flavor
    when 'dev'
      'dev'
    when 'qa'
      'qa'
    when 'staging'
      'staging'
    when 'prod'
      'prod'
    else
      'dev'
    end
    
    # Disable automatic code signing for Release builds (use manual signing with match profiles)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV['MATCH_TYPE'] == 'appstore' ? "match AppStore com.petrasoftsolutions.mobile.#{flavor}" : "match AdHoc com.petrasoftsolutions.mobile.#{flavor}",
      bundle_identifier: "com.petrasoftsolutions.mobile.#{flavor}",
      build_configurations: ["Release-#{flavor}"]
    )
    
    # Build with xcodebuild (signed)
    build_ios_app(
      scheme: scheme_name,
      configuration: "Release-#{flavor}",
      export_method: ENV['MATCH_TYPE'] == 'appstore' ? 'app-store' : 'ad-hoc',
      output_directory: "./build",
      output_name: "Runner-#{flavor}.ipa",
      export_options: {
        method: ENV['MATCH_TYPE'] == 'appstore' ? 'app-store' : 'ad-hoc',
        provisioningProfiles: {
          "com.petrasoftsolutions.mobile.#{flavor}" => ENV['MATCH_TYPE'] == 'appstore' ? "match AppStore com.petrasoftsolutions.mobile.#{flavor}" : "match AdHoc com.petrasoftsolutions.mobile.#{flavor}"
        },
      },
    )
    
    # CRITICAL FIX: Fastlane gym does NOT automatically copy SwiftSupport from xcarchive to IPA
    # Manually add SwiftSupport folder to fix ITMS-90426 rejection
    ipa_path = File.expand_path("../build/Runner-#{flavor}.ipa")
    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    script_path = File.expand_path("../add_swift_support.sh")
    
    UI.important "🔧 Adding SwiftSupport to IPA (required for App Store submission)..."
    UI.message "  IPA: #{ipa_path}"
    UI.message "  Archive: #{archive_path}"
    sh("chmod +x \"#{script_path}\"")
    sh("\"#{script_path}\" \"#{ipa_path}\" \"#{archive_path}\"")
    UI.success "✅ SwiftSupport successfully added to IPA"
  end

  desc "Upload iOS app to TestFlight or App Store"
  lane :upload do |options|
    flavor = options[:flavor]
    
    # Authenticate with App Store Connect API
    app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
      key_content: Base64.decode64(ENV['APP_STORE_CONNECT_API_KEY_BASE64']),
      is_key_content_base64: false,
      in_house: false
    )
    
    if ENV['MATCH_TYPE'] == 'appstore'
      # Upload to App Store / TestFlight (prod)
      upload_to_testflight(
        ipa: "./build/Runner-#{flavor}.ipa",
        skip_waiting_for_build_processing: true
      )
    else
      # For non-prod (adhoc), upload to TestFlight as beta
      upload_to_testflight(
        ipa: "./build/Runner-#{flavor}.ipa",
        skip_waiting_for_build_processing: true,
        distribute_external: false  # Internal testing only
      )
    end
  end

  desc "Build and upload iOS app"
  lane :build_and_upload do |options|
    build(options)
    upload(options)
  end
end
